{
  "description": "Approve a short list of read-only agami sm calls and agami's own scratch files under <artifacts_dir>/local/tmp; says nothing about anything else.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/approve_own_calls.py\" || python -I \"${CLAUDE_PLUGIN_ROOT}/scripts/approve_own_calls.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
